# URL pública del backend (Railway)
BACKEND_URL=https://aura-suite-backend-production.up.railway.app
# Mismo valor que DASHBOARD_TOKEN en el backend. Solo lo usa el servidor de Next: el navegador nunca lo ve.
DASHBOARD_TOKEN=
# (Recomendado) Contraseña de acceso a toda la web (Basic Auth). Si lo dejas vacío, la web queda abierta.
ACCESS_PASSWORD=
