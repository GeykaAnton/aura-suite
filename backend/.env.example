# ─────────────────────────────────────────────────────────────
# Aura Suite – Backend (Fase 1). Copia este archivo a .env
# Todo funciona en modo "mock" sin llaves, para que puedas probar
# el flujo completo en tu laptop antes de conectar servicios reales.
# ─────────────────────────────────────────────────────────────

PORT=3000
LOG_LEVEL=info
TIMEZONE=America/Caracas

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────
# Token que TÚ inventas y pegas en el panel de Meta al registrar el webhook
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-un-texto-largo
# Token de acceso (System User token permanente, no el temporal de 24h)
WHATSAPP_ACCESS_TOKEN=
# ID del número de teléfono (no es el número, es el ID que da Meta)
WHATSAPP_PHONE_NUMBER_ID=
# App Secret: sirve para verificar que el webhook viene de Meta (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Revisa la versión vigente de Graph API en developers.facebook.com
GRAPH_API_VERSION=v23.0

# ── IA (Claude) ───────────────────────────────────────────────
# claude = usa la API de Anthropic | mock = parser de reglas local (gratis, para pruebas)
LLM_MODE=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low es suficiente para extraer transacciones; súbelo si ves errores de interpretación
LLM_EFFORT=low

# ── Transcripción (Whisper) ───────────────────────────────────
# whisper = API compatible con OpenAI (OpenAI o Groq) | mock = usa el texto simulado
TRANSCRIPTION_MODE=mock
# OpenAI:  https://api.openai.com/v1/audio/transcriptions   (modelo: whisper-1)
# Groq:    https://api.groq.com/openai/v1/audio/transcriptions (modelo: whisper-large-v3) – más barato/rápido
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# ── Tasa BCV ──────────────────────────────────────────────────
# dolarapi = API pública que replica la tasa oficial | bcv = scraping de bcv.org.ve | manual = BCV_MANUAL_RATE
BCV_PROVIDER=dolarapi
BCV_MANUAL_RATE=
# USDT normalmente cotiza por encima de BCV en Venezuela. 1 = tratarlo igual al dólar.
USDT_USD_RATE=1

# ── Base de datos ─────────────────────────────────────────────
# Vacío = almacenamiento en memoria (se borra al reiniciar). Ej. Supabase:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Habilita POST /dev/simulate (¡apágalo en producción!)
ENABLE_DEV_ROUTES=true
