    "smoke": "node --env-file-if-exists=.env scripts/smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "decimal.js": "^10.4.3",
    "fastify": "^5.2.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  }
}
