{
  "name": "aura-suite-backend",
  "version": "0.1.0",
  "description": "Aura Suite – Fase 1 (El Núcleo): webhook de WhatsApp, IA financiera y tasa BCV",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
